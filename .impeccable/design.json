      "css": ".ds-conditions{font-family:'Poppins',system-ui,-apple-system,'Segoe UI',sans-serif;list-style:none;margin:0;padding:0;background:var(--ax-surface,#fff);color:var(--ax-ink,#0f1115)}.ds-condition{display:grid;grid-template-columns:32px minmax(0,1fr) 120px;gap:10px;align-items:start;padding:10px 0;border-bottom:1px solid var(--ax-line-soft,#8a909c)}.ds-condition-number{color:var(--ax-text-3,#5b6070);font-variant-numeric:tabular-nums;padding-top:1px;font-size:14px}.ds-condition-title{display:block;font-size:14.5px;font-weight:500}.ds-condition-detail{display:block;font-size:13px;color:var(--ax-text-3,#5b6070);margin-top:1px;overflow-wrap:anywhere}.ds-condition-status{text-align:right;font-size:13px;font-weight:500;color:var(--ax-ok,#0a6e5c)}@media(max-width:640px){.ds-condition{grid-template-columns:24px minmax(0,1fr)}.ds-condition-status{grid-column:2;text-align:left}}"
