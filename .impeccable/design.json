      "kind": "card",
      "refersTo": "panel",
      "description": "Flat, bounded supporting information; no ambient card shadow.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-panel-heading\"><h3 class=\"ds-panel-title\">Customer</h3></div><dl class=\"ds-panel-facts\"><div class=\"ds-panel-fact\"><dt class=\"ds-panel-label\">Name</dt><dd class=\"ds-panel-value\">Daniel Jackson</dd></div></dl></section>",
