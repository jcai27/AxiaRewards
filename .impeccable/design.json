      "kind": "input",
      "refersTo": "search-input",
      "description": "Queue or table search with a visible boundary and enclosing focus ring.",
      "html": "<div class=\"ds-search\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input class=\"ds-search-field\" aria-label=\"Search rebates\" placeholder=\"Name, tracking number, code?\"/></div>",
      "css": ".ds-search{font-family:'Poppins',system-ui,-apple-system,'Segoe UI',sans-serif;display:flex;align-items:center;gap:8px;height:34px;padding:0 10px;border:1px solid var(--ax-line-strong,#5b6070);border-radius:var(--ax-radius,8px);background:var(--ax-surface,#fff);color:#8a8595}.ds-search:focus-within{border-color:var(--ax-brand,#001c77);box-shadow:0 0 0 3px #001c7722}.ds-search-field{font-family:'Poppins',system-ui,-apple-system,'Segoe UI',sans-serif;width:100%;min-width:0;border:0;background:var(--ax-surface,#fff);color:var(--ax-ink,#0f1115);font-size:13.5px}.ds-search-field:focus{outline:0;box-shadow:none}.ds-search-field::placeholder{color:var(--ax-text-3,#5b6070);opacity:1}"
    },
    {
      "name": "Current Sidebar Navigation",
      "kind": "nav",
